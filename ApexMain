-- keybinds
local UIS2 = game:GetService("UserInputService")
local KB_TUCK   = Enum.KeyCode.C
local KB_UNSTUN = Enum.KeyCode.U
local KB_RESETHB = Enum.KeyCode.H

UIS2.InputBegan:Connect(function(inp, proc)
    if proc then return end
    if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if inp.KeyCode == KB_TUCK then
        autoTuckEnabled = not autoTuckEnabled
        notif("Auto Tuck", autoTuckEnabled and "On" or "Off", autoTuckEnabled and GREEN or RED)
    end
    if inp.KeyCode == KB_UNSTUN then
        autoUnstunOn = not autoUnstunOn
        notif("Auto Unstun", autoUnstunOn and "On" or "Off", autoUnstunOn and GREEN or RED)
    end
    if inp.KeyCode == KB_RESETHB then
        pcall(function()
            local c = LocalPlayer.Character; if not c then return end
            local hb = c:FindFirstChild("Hitbox"); if not hb then return end
            hb.Size = Vector3.new(4, 6, 4)
            userHitboxSize = Vector3.new(4, 6, 4)
        end)
        notif("Hitbox", "Reset to default", AC)
    end
end)

