-- auto hitbox resize when holding ball
local userHitboxSize = Vector3.new(5,7,5) -- default, syncs with magnet slider
local function watchBallInHand()
    local char = LocalPlayer.Character; if not char then return end
    local hb = char:FindFirstChild("Hitbox"); if not hb then return end
    char.ChildAdded:Connect(function(child)
        if child.Name == "Football" and child:IsA("Tool") then
            task.wait(0.05)
            pcall(function() hb.Size = Vector3.new(1, 2.2, 1) end)
        end
    end)
    char.ChildRemoved:Connect(function(child)
        if child.Name == "Football" and child:IsA("Tool") then
            task.wait(0.05)
            pcall(function() hb.Size = userHitboxSize end)
        end
    end)
end
if LocalPlayer.Character then watchBallInHand() end
