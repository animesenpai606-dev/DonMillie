        if autoTuckConn then autoTuckConn:Disconnect(); autoTuckConn=nil end
        autoTuckConn=char.ChildAdded:Connect(function(child)
            if not autoTuckEnabled then return end
            if child.Name~="Football" or not child:IsA("Tool") then return end
            -- only tuck if player is catching
            local isCatching = false
            pcall(function()
                local cv = char:FindFirstChild("Hitbox") and char.Hitbox:FindFirstChild("CharacterValues")
                local catchVal = cv and cv:FindFirstChild("Catching")
                isCatching = catchVal and catchVal.Value == true
            end)
