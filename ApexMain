local function cleanHitbox(character)
    local hitbox = character:FindFirstChild("Hitbox")
    if not hitbox then
        return
    end

    -- Delete HitboxSync
    local hitboxSync = hitbox:FindFirstChild("HitboxSync")
    if hitboxSync then
        hitboxSync:Destroy()
    end

    -- Delete HitboxSync
    local AntiCheat = hitbox:FindFirstChild("LocalAntiCheat")
    if AntiCheat then
        AntiCheat:Destroy()
    end

    -- Delete only the LocalScript with no children
    for _, obj in ipairs(hitbox:GetChildren()) do
        if obj:IsA("LocalScript") and #obj:GetChildren() == 0 then
            obj:Destroy()
            break
        end
    end
end

local function setup(character)
    task.wait(1)
    cleanHitbox(character)
end

